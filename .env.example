# Copy these values into your terminal/session environment. Do not commit a real password.
LABMATE_DB_HOST=10.1.1.44
LABMATE_DB_PORT=3306
LABMATE_DB_NAME=labmate_fetched_data
LABMATE_DB_USER=sahil
LABMATE_DB_PASSWORD=replace-with-your-password
LABMATE_RECEIPT_PASSWORD=replace-with-receipt-password

# Optional catalog override; defaults to the LabMate connection and bhasin_7001_new.
CATALOG_DB_NAME=bhasin_7001_new

# The running Flask project refreshes the local patients/patient_tests mirror.
REMOTE_SYNC_INTERVAL_SECONDS=1200
REMOTE_SYNC_LOOKBACK_DAYS=5

